HTTP_ADDR=:8080
JWT_SECRET=replace-with-a-long-random-secret
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Format: name=base_url|api_key|default_model[,name=base_url|api_key|default_model]
LLM_PROVIDERS=openai=https://api.openai.com/v1|replace-me|gpt-4o-mini
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_MINUTES=1440
SUPERVISOR_URL=http://localhost:8001
SUPERVISOR_TOKEN=replace-with-an-internal-secret
MCP_SERVERS={}
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
AGENT_MODEL=gpt-4o-mini
